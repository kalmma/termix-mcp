# Required
TERMIX_BASE_URL=http://localhost:30001
TERMIX_API_KEY=your_termix_api_key_here

# Optional - default to TERMIX_BASE_URL's host with the port swapped.
# Only set these if your deployment exposes these services elsewhere.
# TERMIX_METRICS_URL=http://localhost:30005
# TERMIX_DASHBOARD_URL=http://localhost:30006
# TERMIX_TUNNEL_URL=http://localhost:30003
